files:
  "/etc/pip.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      [global]
      build-dir = /var/tmp
      cache-dir = /var/tmp

commands:
  01_debug_pip:
    command: |
      echo "Current user: $(whoami)" >> /var/log/debug.log
      echo "Home directory: $HOME" >> /var/log/debug.log
      echo "Current directory: $(pwd)" >> /var/log/debug.log
      ls -la /etc/ | grep pip >> /var/log/debug.log 2>&1 || echo "No pip files in /etc" >> /var/log/debug.log
      mkdir -p /home/webapp/.pip